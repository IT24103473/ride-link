# ---------------------------------------------------------------------------
# RideLink local configuration template.
# Copy to `.env` (git-ignored) and replace every value before running anything.
# All values below are obviously fake placeholders - never commit real secrets.
# ---------------------------------------------------------------------------

# --- JWT (shared HS256 secret; must be at least 32 bytes) -------------------
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_TTL_MINUTES=60

# --- Seeded admin account (Account Service creates it if absent) ------------
ADMIN_EMAIL=admin@ridelink.test
ADMIN_PASSWORD=ChangeMe123

# --- MySQL -----------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me

ACCOUNT_DB_USERNAME=account_svc
ACCOUNT_DB_PASSWORD=change-me
DRIVER_DB_USERNAME=driver_svc
DRIVER_DB_PASSWORD=change-me
RIDE_DB_USERNAME=ride_svc
RIDE_DB_PASSWORD=change-me
PAYMENT_DB_USERNAME=payment_svc
PAYMENT_DB_PASSWORD=change-me

# --- RabbitMQ --------------------------------------------------------------
RABBITMQ_USERNAME=ridelink
RABBITMQ_PASSWORD=change-me

# --- Service-to-service client credentials ---------------------------------
RIDE_SERVICE_CLIENT_ID=ride-service
RIDE_SERVICE_CLIENT_SECRET=change-me
